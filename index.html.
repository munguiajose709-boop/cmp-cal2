
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101827">
<title>CMP Cal</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101827;color:#f1f5f9;font-family:Arial,sans-serif;padding:20px}
header{text-align:center;margin:20px 0 28px}
header h1{color:#38bdf8;font-size:30px;margin-bottom:5px}
header p{color:#94a3b8}
.card{background:#1e293b;padding:18px;border-radius:16px;margin-bottom:16px}
h2{font-size:18px;color:#38bdf8;margin-top:0}
label{display:block;margin:13px 0 6px;color:#cbd5e1}
input,select{width:100%;padding:13px;border:1px solid #475569;border-radius:9px;background:#0f172a;color:white;font-size:16px}
button{width:100%;padding:14px;border:0;border-radius:10px;background:#0284c7;color:white;font-size:16px;font-weight:bold;margin-top:15px}
.result{margin-top:15px;padding:14px;background:#0f172a;border-radius:10px;color:#4ade80;font-size:18px;overflow-wrap:anywhere}
small{color:#94a3b8}
</style>
</head>
<body>
<header>
<h1>CMP Cal</h1>
<p>Calculadora médica clínica</p>
<small>Versión 1.0</small>
</header>

<div class="card">
<h2>1. Conversor mg ↔ mL (cc)</h2>
<label>Dosis o cantidad (mg)</label>
<input id="mg" type="number" min="0" step="any" placeholder="Ej. 120">
<label>Concentración del medicamento</label>
<input id="conc" type="number" min="0" step="any" placeholder="Ej. 120">
<label>Volumen de referencia (mL)</label>
<input id="vol" type="number" min="0" step="any" value="5">
<button onclick="convertir()">Calcular mL (cc)</button>
<div class="result" id="r1">Resultado: pendiente</div>
</div>

<div class="card">
<h2>2. Dosis por peso</h2>
<label>Peso del paciente (kg)</label>
<input id="peso" type="number" min="0" step="any" placeholder="Ej. 15">
<label>Dosis indicada (mg/kg/dosis)</label>
<input id="dosis" type="number" min="0" step="any" placeholder="Ej. 10">
<button onclick="pediatria()">Calcular dosis</button>
<div class="result" id="r2">Resultado: pendiente</div>
</div>

<div class="card">
<h2>3. Líquidos de mantenimiento</h2>
<label>Peso (kg)</label>
<input id="pesoL" type="number" min="0" step="any" placeholder="Ej. 20">
<button onclick="liquidos()">Calcular mantenimiento</button>
<div class="result" id="r3">Resultado: pendiente</div>
<small>Estimación teórica por Holliday-Segar. No sustituye la valoración clínica.</small>
</div>

<script>
function n(id){return Number(document.getElementById(id).value)}
function convertir(){
let mg=n('mg'),c=n('conc'),v=n('vol');
if(mg<=0||c<=0||v<=0){r1.textContent='Introduce valores válidos';return}
r1.textContent='Volumen: '+(mg/(c/v)).toFixed(2)+' mL (cc)';
}
function pediatria(){
let p=n('peso'),d=n('dosis');
if(p<=0||d<=0){r2.textContent='Introduce valores válidos';return}
r2.textContent='Cantidad calculada: '+(p*d).toFixed(2)+' mg por dosis';
}
function liquidos(){
let p=n('pesoL'),total=0;
if(p<=0){r3.textContent='Introduce un peso válido';return}
if(p<=10)total=p*100;
else if(p<=20)total=1000+(p-10)*50;
else total=1500+(p-20)*20;
r3.textContent='Mantenimiento estimado: '+total+' mL/24 h ('+(total/24).toFixed(1)+' mL/h)';
}
</script>
</body>
</html>
